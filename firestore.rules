rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email == "shovqiddin45@gmail.com") ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validation helpers
    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function isValidMapString(val, min, max) {
      return val is map && val.get('UZ', '') is string && val.get('UZ', '').size() >= min;
    }

    function isValidBooking(data) {
      return data.userId is string &&
             isValidString(data.name, 2, 100) &&
             isValidString(data.phone, 7, 20) &&
             (data.roomType is string || data.roomType is map) &&
             isValidString(data.checkIn, 10, 30) &&
             isValidString(data.checkOut, 10, 30) &&
             data.createdAt is string;
    }

    // Rooms: Anyone can read, only admins can write
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings: Anyone can read, only admins can write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings: Users can read/create their own, admins can read/write all
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidBooking(request.resource.data);
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && 
                                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOut', 'people', 'phone', 'telegram', 'mahalla']));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Public Bookings: Anyone can read, only admins or the booking creator can write
    // This collection contains NO PII (no names, no passports)
    match /public_bookings/{bookingId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Admins: Users can read their own admin status, admins can read/write all
    match /admins/{adminId} {
      allow get: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
